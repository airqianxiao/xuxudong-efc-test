{
  "name": "xuxudong-efc-test",
  "installCommand": "npm install",

  "assets": {
    // 本仓库静态资源在 public/（模板示例的 ./dist 是 vite 产物目录，不适用本仓库）
    "directory": "./public",
    // 用于验证"既不命中静态也不命中云函数"时是回源还是 404（文档待确认项）
    "notFoundStrategy": "singlePageApplication"
  },

  // 按用例切换取值：true / false / 路由列表(如 ["/api/*", "!/api/health"]) / 空列表 []
   "edgeFunctionFirst": true,

  "regionFunction": {
    // 基础版固定 1c2g；2c4g 仅高级版/企业版可用，按当前套餐填
    "instanceType": "1c2g",
    "minInstances": 1,
    "concurrency": 200
  }
}
